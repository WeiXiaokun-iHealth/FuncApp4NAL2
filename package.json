{
  "name": "funcapp4nal2",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "server": "bash scripts/run-server.sh",
    "android": "bash scripts/run-app.sh",
    "update:nal2": "bash scripts/update-nal2-module.sh",
    "android:fresh": "bash scripts/update-nal2-module.sh && yarn clean:all && yarn install && bash scripts/run-app.sh",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:build-install:release": "bash scripts/android-release-install.sh",
    "android:install:debug": "adb install android/app/build/outputs/apk/debug/app-debug.apk",
    "android:install:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "ios": "expo run:ios",
    "ios:pod": "cd ios && pod install",
    "clean:android": "cd android && ./gradlew clean",
    "clean:metro": "rm -rf node_modules/.cache/metro-*",
    "clean:all": "yarn clean:metro && yarn clean:android && rm -rf node_modules && rm -rf ios/build",
    "update-config": "node scripts/update-config.js",
    "start-all": "bash scripts/start-all.sh",
    "stop": "bash scripts/stop-all.sh",
    "test": "node tests/nal2_automated_tests.js",
    "test:watch": "nodemon tests/nal2_automated_tests.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/react": "~18.2.45",
    "expo": "~50.0.14",
    "expo-dev-client": "^3.3.11",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-fs": "^2.20.0",
    "react-native-nal2": "file:./modules/nal2/react-native-nal2-v0.0.0.tgz",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
